<?xml version="1.0" encoding="utf-8"?>
<!-- waybill serve runs on your own network, often as plain HTTP to a LAN
     address. HTTPS is used whenever the pair link says https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
